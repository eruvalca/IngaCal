@inherits LayoutComponentBase
@implements IDisposable
@inject BrowserContext Browser
<div class="app-shell">
    <aside class="app-sidebar">
        <a class="brand" href="/"><span class="brand-symbol"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span> IngaCal<span class="brand-dot">.</span></a>
        <p class="sidebar-caption">A little more intentional.</p>
        <NavMenu />
        <div class="sidebar-footer">
            <label class="small text-body-secondary" for="theme-picker">Appearance</label>
            <select id="theme-picker" data-theme-picker class="form-select form-select-sm mt-2" aria-label="Appearance">
                <option value="system">Follow system</option><option value="light">Light</option><option value="dark">Dark</option>
            </select>
            <div class="small text-body-secondary mt-3"><i class="bi bi-circle-fill status-dot me-2" aria-hidden="true"></i>Your time, thoughtfully kept.</div>
        </div>
    </aside>
    <main class="app-main">
        @if (RendererInfo.IsInteractive && Browser.Error is not null)
        {
            <div class="alert alert-warning m-4"><p>@Browser.Error</p><TimeZonePicker /></div>
        }
        <div class="page-content">@Body</div>
        <footer class="app-footer"><span>Make room for what matters.</span>
            @if (Browser.IsReady) { <span><i class="bi bi-globe2 me-1" aria-hidden="true"></i>@Browser.TimeZoneId</span> }
        </footer>
    </main>
</div>
<div id="blazor-error-ui" data-nosnippet>Something interrupted the connection. <a href="." class="reload">Reload</a><button class="dismiss" aria-label="Dismiss">×</button></div>
@code {
    protected override void OnInitialized() => Browser.Changed += OnChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Browser.InitializeAsync();
            await InvokeAsync(StateHasChanged);
        }
    }
    private Task OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Browser.Changed -= OnChanged;
}
