@page "/reports"
@attribute [Authorize]
@inherits JournalPageBase
@inject IReportService ReportService
@inject ITagService TagService
<PageTitle>Your reports · IngaCal</PageTitle>
<div class="page-heading"><div><p class="eyebrow">MAKE SPACE FOR WHAT MATTERS</p><h1>Time, in perspective<span class="heading-dot">.</span></h1><p class="page-subtitle">Small moments. A bigger picture of your days.</p></div><span class="section-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span></div>
@if (Error is not null) { <div class="alert alert-danger" role="alert">@Error <button class="btn btn-sm btn-outline-danger" @onclick="() => RunAsync(LoadAsync)">Retry</button></div> }
@if (Browser.IsReady) {
    <ReportFilters Today="Browser.Today" TimeZoneId="@Browser.TimeZoneId" Tags="tags" Busy="Busy" Changed="FilterChanged" />
    @if (data is not null) {
        <div class="report-period">@filter!.From.ToString("MMM d, yyyy") — @filter.To.ToString("MMM d, yyyy") <span>· @Browser.TimeZoneId</span></div>
        <ReportSummary Data="data" />
        @if (data.ActivityCount == 0) { <div class="empty-state surface-card mb-4"><i class="bi bi-sun" aria-hidden="true"></i><h2>A little space to begin</h2><p>No activities match this period and these filters.</p><a class="btn btn-outline-primary" href="/">Go to your calendar</a></div> }
        else { <ReportCharts Data="data" Grouping="filter.Grouping" Theme="@Browser.Theme" /> }
        <ReportTables Data="data" Grouping="filter.Grouping" />
    }
} else { <div class="loading-panel" role="status">Getting your reports ready…</div> }
@code {
    private IReadOnlyList<TagDto> tags = [];
    private ReportFilter? filter;
    private ReportDto? data;
    protected override async Task LoadAsync() {
        filter ??= new(Browser.Today.AddDays(-6), Browser.Today, Browser.TimeZoneId, []);
        filter = filter with { TimeZoneId = Browser.TimeZoneId };
        tags = await TagService.ListAsync(Lifetime.Token);
        data = await ReportService.GetAsync(filter, Lifetime.Token);
    }
    private async Task FilterChanged(ReportFilter value) {
        Busy = true;
        await RunAsync(async () => { var result = await ReportService.GetAsync(value, Lifetime.Token); filter = value; data = result; });
        Busy = false;
    }
}
