@page "/tags"
@attribute [Authorize]
@inherits JournalPageBase
@inject ITagService TagService
<PageTitle>Your tags · IngaCal</PageTitle>
<div class="page-heading"><div><p class="eyebrow">GIVE YOUR TIME A LITTLE CONTEXT</p><h1>Your tags<span class="heading-dot">.</span></h1><p class="page-subtitle">Work, rest, a good book. Make a collection that feels like you.</p></div><span class="section-icon"><i class="bi bi-tags" aria-hidden="true"></i></span></div>
@if (Error is not null) { <div class="alert alert-danger" role="alert">@Error <button class="btn btn-sm btn-outline-danger" @onclick="Refresh">Refresh tags</button></div> }
<section class="surface-card p-4 mb-4">
    <h2>@(editing is null ? "Create a tag" : $"Edit {editing.Name}")</h2>
    <form @onsubmit="Save" @onsubmit:preventDefault>
        <div class="row g-3 align-items-end">
            <div class="col-8 col-md-6"><label for="tag-name" class="form-label">Name</label><input id="tag-name" class="form-control" @bind="name" maxlength="60" required placeholder="e.g. Deep work" /></div>
            <div class="col-4 col-md-2"><label for="tag-color" class="form-label">Color</label><input id="tag-color" class="form-control form-control-color w-100" type="color" @bind="color" /></div>
            <div class="col-md-4 d-flex gap-2"><button type="submit" class="btn btn-primary" disabled="@Busy">@(editing is null ? "Create tag" : "Save changes")</button>@if (editing is not null) { <button type="button" class="btn btn-outline-secondary" @onclick="Reset">Cancel</button> }</div>
        </div>
    </form>
</section>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h2 class="mb-0">Your collection <span class="text-body-secondary fs-6">(@tags.Count(x => !x.IsArchived))</span></h2>
    <label class="form-check mb-0"><input type="checkbox" class="form-check-input" @bind="showArchived" /> Show archived tags</label>
</div>
@if (tags.Count == 0) { <div class="empty-state surface-card"><i class="bi bi-tags" aria-hidden="true"></i><h2>Every day has a few themes</h2><p>Create your first tag above, then add it to any activity.</p></div> }
<div class="row g-3">
    @foreach (var tag in tags.Where(x => showArchived || !x.IsArchived)) {
        <div class="col-sm-6 col-xl-4" @key="tag.Id"><section class="surface-card tag-card">
            <div class="mb-4"><TagBadge Tag="tag" /></div>
            <div class="d-flex gap-2"><button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(tag)" disabled="@Busy" aria-label="@($"Edit {tag.Name}")"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit</button><button class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="() => Archive(tag)" aria-label="@($"{(tag.IsArchived ? "Restore" : "Archive")} {tag.Name}")">@(tag.IsArchived ? "Restore" : "Archive")</button></div>
        </section></div>
    }
</div>
<p class="text-body-secondary small mt-4"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Archived tags stay on past activities and in your reports. You can restore them at any time.</p>
@code {
    private IReadOnlyList<TagDto> tags = [];
    private TagDto? editing;
    private string name = "", color = "#287658";
    private bool showArchived;
    protected override async Task LoadAsync() => tags = await TagService.ListAsync(Lifetime.Token);
    private void Edit(TagDto tag) { editing = tag; name = tag.Name; color = tag.Color; Error = null; }
    private void Reset() { editing = null; name = ""; color = "#287658"; }
    private async Task Refresh() { Reset(); await RunAsync(LoadAsync); }
    private async Task Save() {
        Busy = true;
        await RunAsync(async () => { await TagService.SaveAsync(new(editing?.Id, name, color, editing?.IsArchived ?? false, editing?.Version ?? default), Lifetime.Token); Reset(); await LoadAsync(); });
        Busy = false;
    }
    private async Task Archive(TagDto tag) {
        Busy = true;
        await RunAsync(async () => { await TagService.SaveAsync(new(tag.Id, tag.Name, tag.Color, !tag.IsArchived, tag.Version), Lifetime.Token); if (editing?.Id == tag.Id) Reset(); await LoadAsync(); });
        Busy = false;
    }
}
