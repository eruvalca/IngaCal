<section class="surface-card p-4 mb-4" aria-label="Report filters">
    <div class="d-flex gap-2 flex-wrap mb-4">
        @foreach (var preset in presets) { <button class="btn btn-sm @(selectedPreset == preset ? "btn-primary" : "btn-outline-secondary")" @onclick="() => Preset(preset)">@preset</button> }
    </div>
    <div class="row g-3 align-items-end">
        <div class="col-6 col-lg-3"><label class="form-label" for="report-from">From</label><input id="report-from" class="form-control" type="date" @bind="from" @bind:after="Custom" /></div>
        <div class="col-6 col-lg-3"><label class="form-label" for="report-to">Through</label><input id="report-to" class="form-control" type="date" @bind="to" @bind:after="Custom" /></div>
        <div class="col-6 col-lg-3"><label class="form-label" for="report-group">Trend interval</label><select id="report-group" class="form-select" @bind="grouping"><option value="@ReportGrouping.Daily">Daily</option><option value="@ReportGrouping.Weekly">Weekly</option></select></div>
        <div class="col-6 col-lg-3"><button class="btn btn-primary w-100" disabled="@Busy" @onclick="Apply">@(Busy ? "Updating…" : "Update report")</button></div>
    </div>
    <details class="mt-3"><summary class="filter-summary">Filter by tags <span class="text-body-secondary">@(untagged ? "· Untagged only" : selected.Count > 0 ? $"· {selected.Count} selected" : "· All activities")</span></summary>
        <div class="d-flex align-items-center flex-wrap gap-3 mt-3">
            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="untagged" /> Untagged only</label>
            <label for="tag-match">Match</label><select id="tag-match" class="form-select w-auto" @bind="match" disabled="@untagged"><option value="@TagMatch.Any">Any selected tag</option><option value="@TagMatch.All">All selected tags</option></select>
            <button class="btn btn-sm btn-link" @onclick="Clear">Clear tags</button>
        </div>
        <div class="d-flex gap-2 flex-wrap mt-2">
            @foreach (var tag in Tags) { <button class="btn btn-sm @(selected.Contains(tag.Id) ? "btn-primary" : "btn-outline-secondary")" disabled="@untagged" aria-pressed="@(selected.Contains(tag.Id) ? "true" : "false")" @onclick="() => Toggle(tag.Id)">@tag.Name @(tag.IsArchived ? "(archived)" : "")</button> }
            @if (Tags.Count == 0) { <p class="text-body-secondary mb-0">Tags you create will appear here.</p> }
        </div>
    </details>
</section>
@code {
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public string TimeZoneId { get; set; } = "UTC";
    [Parameter] public IReadOnlyList<TagDto> Tags { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<ReportFilter> Changed { get; set; }
    private DateOnly from, to;
    private readonly string[] presets = ["Last 7 days", "Last 30 days", "This month", "Last month"];
    private string selectedPreset = "Last 7 days";
    private HashSet<Guid> selected = [];
    private TagMatch match;
    private ReportGrouping grouping;
    private bool untagged;
    protected override void OnInitialized() { from = Today.AddDays(-6); to = Today; }
    private void Custom() => selectedPreset = "";
    private void Clear() { selected.Clear(); untagged = false; }
    private void Toggle(Guid id) { if (!selected.Add(id)) selected.Remove(id); }
    private Task Preset(string preset) {
        selectedPreset = preset; to = Today;
        from = preset switch { "Last 30 days" => Today.AddDays(-29), "This month" => new(Today.Year, Today.Month, 1), "Last month" => new DateOnly(Today.Year, Today.Month, 1).AddMonths(-1), _ => Today.AddDays(-6) };
        if (preset == "Last month") to = new DateOnly(Today.Year, Today.Month, 1).AddDays(-1);
        return Apply();
    }
    private Task Apply() => Changed.InvokeAsync(new(from, to, TimeZoneId, selected.ToArray(), match, untagged, grouping));
}
